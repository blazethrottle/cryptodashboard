# Supabase
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=12345...client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT (RS256 asymmetric keys, base64 encoded)
JWT_PRIVATE_KEY_RSA=-----BEGIN PRIVATE KEY-----\n...
JWT_PUBLIC_KEY_RSA=-----BEGIN PUBLIC KEY-----\n...

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourapp.com

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Session & Tokens
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800

# Optional: Redis for rate limiting and token blacklist
REDIS_URL=redis://localhost:6379

# Optional: Email service
POSTMARK_API_TOKEN=...
SENDGRID_API_KEY=...
